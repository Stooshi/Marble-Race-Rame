# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins (use * to allow any in dev)
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL -----------------------------------------------------------
DATABASE_URL=postgres://marble:marble@localhost:5432/marble_race
# Set to true when your provider requires TLS (Heroku, Render, RDS, ...)
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Auth -----------------------------------------------------------------
# REQUIRED in production. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- Game -----------------------------------------------------------------
# Countdown streamed to clients between a race being decided and it starting
RACE_COUNTDOWN_MS=5000
# Position frames streamed per second while a race is running
RACE_TICK_RATE_HZ=10
# Coins paid out to human players by finishing position, then for taking part
REWARD_COINS_PODIUM=100,50,25
REWARD_COINS_PARTICIPATION=10
