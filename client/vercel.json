{
  "rewrites": [
    {
      "source": "/(home|lobby|shop|collection|certificate|checkout|pass|bag|purchases|settings|redeem|unsubscribe|forgot-password|reset-password|scores|signup|legal|help|cookies|tracks|dashboard|profile|race|results|play|r|l|leagues|preview|admin|confirm-email)",
      "destination": "/app-shell"
    },
    {
      "source": "/(home|lobby|shop|collection|certificate|checkout|pass|bag|purchases|settings|redeem|unsubscribe|forgot-password|reset-password|scores|signup|legal|help|cookies|tracks|dashboard|profile|race|results|play|r|l|leagues|preview|admin|confirm-email)/:rest*",
      "destination": "/app-shell"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/reset-password",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "cleanUrls": true
}
