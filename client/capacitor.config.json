{
  "appId": "com.marblespins.app",
  "appName": "Marble Spins",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0E1320"
  },
  "android": {
    "backgroundColor": "#0E1320"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#0E1320",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true,
      "backgroundColor": "#00000000"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
